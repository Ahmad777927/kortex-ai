{
  "name": "@services/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "echo 'lint not configured yet'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "fastify": "5.1.0",
    "mongoose": "8.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}

